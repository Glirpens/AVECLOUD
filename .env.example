# Скопируйте в .env и заполните. Файл .env НЕ коммитьте.

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot) — станет администратором
ADMIN_ID=

# Кому разрешён доступ, ID через запятую (админ добавляется автоматически)
ALLOWED_USERS=

# Платный OpenAI-совместимый API — нужен только для анализа файлов
API_BASE_URL=https://api.openai.com/v1
API_KEY=
API_MODEL=gpt-4o-mini
API_IMAGE_MODEL=gpt-image-1

# Папка для баз данных (на Amvera: /data)
DATA_DIR=./data
